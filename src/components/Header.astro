---
const navigation = [
	{ label: 'Home', href: '/' },
	{ label: 'Vision', href: '/vision/' },
	{ label: 'Projekt', href: '/projekt/' },
	{ label: 'Journal', href: '/journal/' },
	{ label: 'Filosofi', href: '/filosofi/' },
	{ label: 'Delta', href: '/delta/' },
];

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const currentPath =
	base === '/' ? Astro.url.pathname : Astro.url.pathname.replace(base.slice(0, -1), '') || '/';
const isCurrent = (href: string) => {
	if (href === '/') {
		return currentPath === '/';
	}

	return currentPath === href || currentPath.startsWith(href);
};
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="site-logo" href={withBase('/')} aria-label="Anemone home">
			<object
				class="site-logo__asset"
				data={withBase('/branding/logo.svg')}
				type="image/svg+xml"
				aria-hidden="true"
				tabindex="-1"
			>
				<span aria-hidden="true"></span>
			</object>
			<span class="site-logo__name">Anemone</span>
		</a>

		<nav class="site-nav" aria-label="Primary navigation">
			<ul class="site-nav__list">
				{navigation.map((item) => (
					<li>
						<a
							href={withBase(item.href)}
							aria-current={isCurrent(item.href) ? 'page' : undefined}
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>
