	<section class="page-section">
		<div class="container">
			<p class="eyebrow">Principer</p>
			<h1 class="page-title">Filosofi</h1>
			<p class="lead">
				En placeholder för arbetssätt, värderingar och grundläggande principer.
			</p>

			<div class="content-panel">
				<h2>Kommer snart</h2>
				<p>Här formas Anemones syn på tempo, kvalitet och omsorg.</p>
			</div>
		</div>
	</section>
</BaseLayout>
