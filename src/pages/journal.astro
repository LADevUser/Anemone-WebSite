---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = (await getCollection('journal', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('sv-SE', { dateStyle: 'long' }).format(date);
---

<BaseLayout title="Journal" description="Anteckningar, reflektioner och uppdateringar från Anemone.">
	<section class="page-section">
		<div class="container">
			<p class="eyebrow">Noterat</p>
			<h1 class="page-title">Journal</h1>
			<p class="lead">
				Anteckningar om arbetet, valen längs vägen och sådant som behöver tänkas vidare.
			</p>

			<ol class="entry-list">
				{entries.map((entry) => (
					<li class="entry-list__item">
						<article>
							<time class="entry-meta" datetime={entry.data.pubDate.toISOString()}>
								{formatDate(entry.data.pubDate)}
							</time>
							<h2 class="entry-list__title">
								<a href={`${base}journal/${entry.id}/`}>{entry.data.title}</a>
							</h2>
							<p>{entry.data.description}</p>
						</article>
					</li>
				))}
			</ol>
		</div>
	</section>
</BaseLayout>
