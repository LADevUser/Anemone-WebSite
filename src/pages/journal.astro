---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Journal" description="Anteckningar, reflektioner och uppdateringar från Anemone.">
	<section class="page-section">
		<div class="container">
			<p class="eyebrow">Noterat</p>
			<h1 class="page-title">Journal</h1>
			<p class="lead">
				En placeholder för anteckningar, uppdateringar och längre reflektioner.
			</p>

			<div class="content-panel">
				<h2>Kommer snart</h2>
				<p>Journalen blir en enkel plats för löpande texter.</p>
			</div>
		</div>
	</section>
</BaseLayout>
