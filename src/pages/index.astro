---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Anemone"
	description="Anemone är en plats för nordisk enkelhet, omsorg och långsiktiga projekt."
>
	<section class="page-section">
		<div class="container">
			<p class="eyebrow">Nordic calm</p>
			<h1 class="page-title">Anemone</h1>
			<p class="lead">
				En stillsam digital plats för visioner, projekt, journal och filosofi.
			</p>

			<div class="content-panel">
				<h2>Under uppbyggnad</h2>
				<p>
					Webbplatsen tar form med fokus på tillgänglighet, snabbhet och enkel
					navigering.
				</p>
			</div>
		</div>
	</section>
</BaseLayout>
