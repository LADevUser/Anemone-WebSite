---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Anemone"
	description="Anemone är en plats för nordisk enkelhet, omsorg och långsiktiga projekt."
>
	<section class="hero">
		<div class="container hero__inner">
			<div class="hero__content">
				<p class="hero__kicker">Stable at the root. Calm by design.</p>
				<h1 class="hero__title">Anemone</h1>
				<p class="hero__lead">
					Har du någonsin känt att världen borde kunna mer än så här?
				</p>
			</div>

			<img
				class="hero__mark"
				src={`${import.meta.env.BASE_URL}branding/hero-mark.svg`}
				alt=""
				width="355"
				height="263"
				loading="eager"
				decoding="async"
			/>
		</div>
	</section>
</BaseLayout>
